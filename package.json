{
  "name": "onlybudget",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node scripts/copy-pdf-worker.js && expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.js",
    "build:web": "node scripts/copy-pdf-worker.js && expo export --platform web --output-dir dist && node scripts/postbuild-web.js dist",
    "check:web-security": "node scripts/web-security-check.mjs dist",
    "audit": "npm audit --omit=dev",
    "postinstall": "node scripts/build-pdf-extractor.js",
    "check:pdf-security": "node --experimental-strip-types --no-warnings scripts/pdf-security-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-speech-recognition": "^57.0.0",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "^0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.11",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3"
  }
}
